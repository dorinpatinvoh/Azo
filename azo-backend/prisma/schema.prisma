// Schéma de base de données AZƆ̀ — PostgreSQL + PostGIS (pour les calculs de distance/zone)
// npx prisma migrate dev --name init   (après avoir configuré DATABASE_URL dans .env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  DRIVER
  AGENCY
  ADMIN
  ARTISAN
}

// État d'un compte utilisateur. Un prestataire dont le dossier est en attente reste
// un CLIENT actif : il peut commander et payer, seule l'entrée métier est verrouillée.
enum UserStatus {
  ACTIVE
  PENDING_VALIDATION
  BLOCKED
}

enum Gender {
  M
  F
}

// ---------------------------------------------------------------------------
// Prestataires : un dossier unique pour tous les types d'activité
// (voir PROJECT_SUMMARY/PRESTATAIRES.md)
// ---------------------------------------------------------------------------

enum ProviderType {
  DRIVER // chauffeur indépendant (zem, zem électrique, voiture)
  AGENCY // agence / flotte
  ARTISAN
  COURIER // livreur — mappé sur le rôle DRIVER tant que le rôle COURIER n'existe pas
}

enum ProviderStatus {
  DRAFT // brouillon non soumis (reprise possible)
  SUBMITTED // déposé, en file d'attente admin
  UNDER_REVIEW // un admin a ouvert le dossier (verrou)
  NEED_INFO // pièce ou information manquante, renvoyé au prestataire
  APPROVED // validé : rôle accordé, espace métier ouvert
  REJECTED // refusé avec motif
  SUSPENDED // gelé (litige, document expiré, signalement)
}

enum DocumentKind {
  CNI
  SELFIE
  PERMIS
  CARTE_GRISE
  ASSURANCE
  VISITE_TECHNIQUE
  PHOTO_VEHICULE
  RCCM
  IFU
  STATUTS
  DIPLOME
  EXTRAIT_CASIER
  PROFILE_PHOTO // photo de profil du Zem / conducteur / coursier
  LOGO // logo de l'agence
}

enum DocumentStatus {
  PENDING
  VALID
  INVALID
}

enum ProviderEventType {
  CREATED
  UPDATED
  SUBMITTED
  DOCUMENT_ADDED
  DOCUMENT_VALIDATED
  DOCUMENT_REJECTED
  REVIEW_STARTED
  INFO_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
  AGENCY_ATTACHED
  AGENCY_DETACHED
}

enum RideStatus {
  PENDING
  OFFERED      // Un Zem a accepté, le client doit confirmer (délai offerExpirySeconds)
  MATCHED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Gammes de véhicules AZƆ̀ (spécification tarifaire) :
// GAZELLE (entrée de gamme), KOALA (intermédiaire climatisé), LEOPARD (haut de gamme).
// Les anciennes valeurs (ZEM, ZEM_ELECTRIC, CAR) ont été migrées :
// ZEM / ZEM_ELECTRIC -> GAZELLE, CAR -> KOALA.
// Types de véhicules AZƆ̀, en deux filières distinctes :
//   * ZEM_ESSENCE / ZEM_ELECTRIC → motos-taxis (filière Zem, même tarif) ;
//   * GAZELLE / KOALA / LEOPARD  → voitures (entrée de gamme, climatisée, premium).
enum VehicleType {
  ZEM_ESSENCE
  ZEM_ELECTRIC
  GAZELLE
  KOALA
  LEOPARD
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  CONFIRMED // transaction finalisée (défaut)
  PENDING   // en attente de confirmation (ex. recharge FedaPay avant callback)
  FAILED    // paiement annulé ou échoué
}

enum Payer {
  SENDER
  RECIPIENT
}

// Niveaux d'agence (les niveaux ne concernent QUE les agences) :
// frais d'activation uniques, commission par course, frais par retrait, plafond de comptes.
enum AgencyPlan {
  PRO
  SILVER
  OR
  DIAMANT
  PLATINE
  ELITE
}

model User {
  id                 String     @id @default(uuid())
  phone              String     @unique
  fullName           String?
  firstName          String?
  lastName           String?
  gender             Gender?
  npiHash            String?    @unique
  npiCipher          String?
  npiLast4           String?
  profileCompletedAt DateTime?
  role               Role       @default(CLIENT)
  status             UserStatus @default(ACTIVE)
  language           String     @default("fr") // fr | en | es | de
  // Type de compte choisi à l'inscription (CLIENT | DRIVER | COURIER | AGENCY) : seule l'inscription « AGENCY » permet d'ouvrir un dossier d'agence
  signupKind         String?
  createdAt          DateTime   @default(now())

  // Nouveaux champs profil (section 1 du cahier des charges)
  email                    String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  identityCorrectedAt      DateTime?   // quand la correction « directe » a été utilisée (une seule fois)
  ratingResetAt            DateTime?   // un administrateur a remis les notes à zéro : les avis antérieurs sont ignorés

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  // Dossier prestataire (null pour un simple client)
  provider ProviderProfile?

  savedPlaces    SavedPlace[]
  supportTickets SupportTicket[]

  wallet                        Wallet?
  ridesAsClient                 Ride[]                      @relation("ClientRides")
  ridesAsDriver                 Ride[]                      @relation("DriverRides")
  notifications                 Notification[]
  pushTokens                    DevicePushToken[]
  deliveriesSent                Delivery[]                  @relation("DeliveryClient")
  rentalBookings                RentalBooking[]
  marketOrders                  MarketplaceOrder[]
  artisanRequests               ArtisanRequest[]            @relation("ArtisanRequestClient")
  npiRegistrationAttempts       NpiRegistrationAttempt[]
  identityCorrectionRequests    IdentityCorrectionRequest[]
  phoneChangeRequests           PhoneChangeRequest[]
  profileChanges                UserProfileChange[]
  rideMessages                  RideMessage[]
  rideTipsAsClient              RideTip[]                   @relation("TipClient")
  rideTipsAsDriver              RideTip[]                   @relation("TipDriver")
}

model NpiRegistrationAttempt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model NpiAccessAudit {
  id        String   @id @default(uuid())
  actorId   String
  targetId  String
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0) // saisies erronées : 3 maximum, puis le code est annulé
  createdAt DateTime @default(now())
}

model Wallet {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  balance  Int    @default(0) // en FCFA
  cashback Int    @default(0)

  transactions Transaction[]
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  type        TransactionType
  status      TransactionStatus @default(CONFIRMED)
  amount      Int
  label       String
  labelKey    String? // clé i18n stable (ex. "TRANSACTION_RIDE_PAYMENT") — traduite par le mobile
  labelParams Json?   // paramètres à interpoler dans la traduction (ex. { "ref": "#abc123" })
  meta        String?
  kind        String? // "RIDE" | "TIP" | "RECHARGE" | "WITHDRAWAL" — filtrage pour calculs financiers
  createdAt   DateTime          @default(now())
}

model Agency {
  id             String     @id @default(uuid())
  name           String
  plan           AgencyPlan @default(PRO)
  // Valeurs par défaut = niveau PRO de la grille officielle (src/pricing/tarification.json).
  commissionRate Float      @default(0.03) // PRO : 3 % de commission par course
  maxAccounts    Int        @default(30) // PRO : 30 comptes maximum (grille du 14/10/2026 : PRO 30, SILVER 75, OR 100, DIAMANT 1 000, PLATINE 2 500, ELITE 5 000)
  activationFee  Int        @default(100000) // PRO : frais d'activation uniques (FCFA)
  feePaidAt      DateTime? // null = frais pas encore encaissés
  createdAt      DateTime   @default(now())

  drivers   User[]
  providers ProviderProfile[]
}

model Ride {
  id          String      @id @default(uuid())
  clientId    String
  client      User        @relation("ClientRides", fields: [clientId], references: [id])
  driverId    String?
  driver      User?       @relation("DriverRides", fields: [driverId], references: [id])
  status      RideStatus  @default(PENDING)
  vehicleType VehicleType

  originLat Float
  originLng Float
  destLat   Float
  destLng   Float

  // Libellés d'adresses lisibles (optionnels, envoyés par le mobile au moment de la création)
  originLabel String? // ex. "Place de l'Étoile Rouge, Cotonou"
  destLabel   String? // ex. "Marché Dantokpa, Cotonou"

  price                       Int
  commission                  Int
  rating                      Int?
  pickupCode                  String? // code de départ : visible du client à ARRIVED, saisi par le Zem
  dropCode                    String? // code d'arrivée : demandé par le Zem, visible du client à IN_PROGRESS, saisi par le Zem
  driverArrivedAt             DateTime?
  driverLat                   Float?
  driverLng                   Float?
  driverHeading               Int?
  driverSpeed                 Float?
  driverLocatedAt             DateTime?
  clientLat                   Float?
  clientLng                   Float?
  clientLocatedAt             DateTime?
  traveledMeters              Int              @default(0)
  odoLat                      Float?
  odoLng                      Float?
  odoAt                       DateTime?
  stopRequestedBy             String?
  stopRequestedAt             DateTime?
  stopRequestedPrice          Int?
  stopRequestedDistanceMeters Int?
  stopAcceptedAt              DateTime? // arrêt accepté : le paiement attend le code d'arrivée saisi par le Zem
  finalPrice                  Int?
  settledDistanceMeters       Int?
  priceMode                   String?
  // Champs pour le statut OFFERED (confirmation du client avant MATCHED)
  offeredAt           DateTime?   // quand le Zem a accepté
  offerExpiresAt      DateTime?   // offeredAt + rides.offerExpirySeconds
  offerSeenAt         DateTime?   // quand le client a ouvert la popup de la proposition (null = pas encore vu)
  declinedDriverIds   String[]    @default([]) // Zem exclus de cette demande (refusés, sans réponse, retirés)
  offers              RideOffer[]
  matchedAt           DateTime?   // quand le client a confirmé (OFFERED → MATCHED)
  completedAt         DateTime?   // quand la course est passée à COMPLETED
  clientRating        Int?        // note (1-5) du client par le chauffeur, après la course
  clientRatedAt       DateTime?
  scheduledAt         DateTime?   // course programmée : heure de prise en charge souhaitée (null = tout de suite)
  scheduledReleasedAt DateTime?   // quand la demande programmée a été ouverte aux chauffeurs (null = pas encore)
  trackPoints                 RideTrackPoint[]
  messages                    RideMessage[]
  tip                         RideTip?
  createdAt                   DateTime         @default(now())
}

model RideTrackPoint {
  id       String   @id @default(uuid())
  rideId   String
  ride     Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  lat      Float
  lng      Float
  accuracy Int?
  speed    Float?
  at       DateTime

  @@index([rideId, at])
}

model Delivery {
  id            String     @id @default(uuid())
  clientId      String
  client        User       @relation("DeliveryClient", fields: [clientId], references: [id])
  courierId     String?
  packageType   String
  pickupAddress String
  dropAddress   String
  pickupCode    String
  deliveryCode  String
  payer         Payer      @default(SENDER)
  price         Int
  status        RideStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  /// "EXPRESS" (livreur express, colis) ou "PERSONAL" (coursier personnel réservé pour une durée)
  mode          String     @default("EXPRESS")
  vehicleType   VehicleType? // coursier personnel : véhicule demandé
  bookingHours  Int? // coursier personnel : durée de réservation (heures)
  bookedUntil   DateTime? // coursier personnel : fin de la réservation (fixée à l'acceptation)
  distanceKm    Float? // coursier personnel : distance estimée par le serveur
}

model RentalBooking {
  id           String   @id @default(uuid())
  clientId     String
  client       User     @relation(fields: [clientId], references: [id])
  vehicleModel String
  formula      String
  pricePerDay  Int
  status       String   @default("pending")
  vehicleId    String?  // véhicule du catalogue (RentalVehicle)
  totalPrice   Int?     // prix total calculé par le serveur (FCFA)
  createdAt    DateTime @default(now())
}

/// Catalogue de location géré en base (prix fixés par le serveur, jamais par le client).
model RentalVehicle {
  id          String   @id @default(uuid())
  name        String
  seats       Int      @default(4)
  pricePerDay Int
  price4h     Int? // formule « 4 heures » (null = non proposée)
  priceWeek   Int? // formule « semaine » (null = non proposée)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MarketplaceOrder {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation(fields: [clientId], references: [id])
  market    String
  items     Json // [{ label, note, price }]
  total     Int
  status    String   @default("escrowed") // escrowed, delivered, refunded
  createdAt DateTime @default(now())
}

model ArtisanRequest {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation("ArtisanRequestClient", fields: [clientId], references: [id])
  category  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  body       String
  type       String
  read       Boolean  @default(false)
  titleKey   String? // clé i18n stable (ex. "NOTIFICATION_RIDE_MATCHED") — traduite par le mobile
  bodyKey    String? // clé i18n stable pour le corps
  params     Json?   // paramètres à interpoler (ex. { "driver": "Romaric", "amount": 1500 })
  createdAt  DateTime @default(now())
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Dossier prestataire — créé à l'inscription (brouillon), soumis par le
// prestataire, instruit et tranché par un administrateur.
// Le rôle métier n'est accordé QU'À l'approbation.
// ---------------------------------------------------------------------------
model ProviderProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   ProviderType
  status ProviderStatus @default(DRAFT)

  // Identité déclarée (wizard prestataire)
  fullName        String?
  city            String?
  zones           String[]
  bio             String?
  experienceYears Int?

  // Spécifique au type d'activité
  vehicleType  VehicleType? // DRIVER / COURIER
  vehicleModel String?
  plateNumber  String?
  categoryId   String? // ARTISAN
  agencyName   String? // AGENCY : raison sociale
  plan         AgencyPlan? // AGENCY : formule choisie (tarif + commission)

  // Rattachement validé à une flotte
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  // Instruction du dossier
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String? // admin ayant statué
  rejectReason     String?
  suspensionReason String?
  infoRequested    String? // ce que l'admin attend (statut NEED_INFO)

  // Vie du compte après approbation
  activatedAt   DateTime?
  rating        Float     @default(0)
  ratingCount   Int       @default(0) // nombre de notes reçues (pour affichage « N notes »)
  jobsCompleted Int       @default(0)
  kycScore      Int       @default(0) // 0-100 : pièces valides et non expirées

  documents ProviderDocument[]
  events    ProviderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([agencyId])
}

model ProviderDocument {
  id         String          @id @default(uuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  kind         DocumentKind
  // Renseigné par l'upload réel des fichiers (étape 3d) : pour l'instant le dossier
  // peut porter la déclaration d'une pièce sans le fichier.
  url          String?
  mimeType     String?
  sizeBytes    Int?
  status       DocumentStatus @default(PENDING)
  expiresAt    DateTime? // permis, assurance, visite technique, CNI
  reviewerNote String?
  uploadedAt   DateTime       @default(now())
  reviewedAt   DateTime?

  @@unique([providerId, kind])
  @@index([status])
}

// Journal du dossier : chaque action est tracée (qui, quand, pourquoi).
model ProviderEvent {
  id         String            @id @default(uuid())
  providerId String
  provider   ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  actorId    String? // null = le prestataire lui-même
  type       ProviderEventType
  comment    String?
  createdAt  DateTime          @default(now())

  @@index([providerId, createdAt])
}

// ---------------------------------------------------------------------------
// Profil utilisateur — nouveaux modèles (section 1 du cahier des charges)
// ---------------------------------------------------------------------------

model IdentityCorrectionRequest {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  gender       Gender?
  reason       String   // motif du client, 10 à 300 caractères
  status       String   @default("PENDING")  // PENDING | APPROVED | REJECTED
  decidedById  String?
  decidedAt    DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}

model PhoneChangeRequest {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newPhone  String
  codeHash  String              // jamais le code en clair
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model UserProfileChange {           // journal d'audit
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  field     String                  // "email" | "emergencyContact" | "firstName" | "lastName" | "gender" | "phone"
  oldValue  String?                 // pour phone : 4 derniers chiffres seulement
  newValue  String?
  at        DateTime  @default(now())

  @@index([userId, at])
}

// ---------------------------------------------------------------------------
// Messagerie de course persistée (section 2 du cahier des charges)
// ---------------------------------------------------------------------------

model RideMessage {
  id         String    @id @default(uuid())
  rideId     String
  ride       Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole String             // "CLIENT" | "PROVIDER"
  text       String             // 1 à 300 caractères, après nettoyage
  createdAt  DateTime  @default(now())
  readAt     DateTime?          // lu par le destinataire

  @@index([rideId, createdAt])
  @@index([senderId, createdAt])
}

// ---------------------------------------------------------------------------
// Pourboire (section 3 du cahier des charges)
// ---------------------------------------------------------------------------

model RideTip {
  id        String    @id @default(uuid())
  rideId    String    @unique             // un seul pourboire par course
  ride      Ride      @relation(fields: [rideId], references: [id])
  clientId  String
  client    User      @relation("TipClient", fields: [clientId], references: [id])
  driverId  String
  driver    User      @relation("TipDriver", fields: [driverId], references: [id])
  amount    Int                           // FCFA, entier
  createdAt DateTime  @default(now())

  @@index([driverId, createdAt])
  @@index([clientId, createdAt])
}

/// Historique des propositions de Zem (mode confirmation) : permet au Zem de savoir comment sa proposition s'est terminée
/// même après avoir été détaché de la course (DEMANDE_BACKEND_FIN_PROPOSITION_ZEM.md).
model RideOffer {
  id        String    @id @default(uuid())
  rideId    String
  ride      Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driverId  String
  status    String    // OFFERED | APPROVED | DECLINED | EXPIRED | WITHDRAWN | CANCELLED
  offeredAt DateTime  @default(now())
  expiresAt DateTime
  endedAt   DateTime?

  @@index([driverId, status])
  @@index([rideId, driverId])
}

/// Adresses enregistrées du client (domicile, travail, autres), synchronisées entre ses appareils.
model SavedPlace {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // HOME | WORK | OTHER (un seul HOME et un seul WORK par client)
  title     String
  address   String?
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
}

/// Assistance : un échange entre un utilisateur et l'équipe AZƆ̀.
model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // RIDE | PAYMENT | ACCOUNT | SAFETY | OTHER
  subject   String
  status    String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  rideId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  SupportMessage[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorRole String // USER | ADMIN
  authorId   String?
  text       String
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// Retraits des gains de l'entreprise (écran « Finances » de l'administrateur) : le disponible = gains − retraits demandés ou versés.
enum CompanyWithdrawalStatus {
  REQUESTED // demandé, pas encore versé
  PAID // versé sur le compte Mobile Money
  CANCELLED // annulé : le montant redevient disponible
}

model CompanyWithdrawal {
  id            String                  @id @default(uuid())
  amount        Int
  phone         String // compte Mobile Money de destination (+229…)
  method        String? // MTN | MOOV | CELTIIS
  note          String?
  status        CompanyWithdrawalStatus @default(REQUESTED)
  reference     String? // référence de l'opération Mobile Money, saisie au versement
  requestedById String
  decidedById   String? // administrateur qui l'a marqué versé ou annulé
  paidAt        DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status])
}
