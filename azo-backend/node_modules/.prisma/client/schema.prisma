// Schéma de base de données AZƆ̀ — PostgreSQL + PostGIS (pour les calculs de distance/zone)
// npx prisma migrate dev --name init   (après avoir configuré DATABASE_URL dans .env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  DRIVER
  AGENCY
  ADMIN
  ARTISAN
}

// État d'un compte utilisateur. Un prestataire dont le dossier est en attente reste
// un CLIENT actif : il peut commander et payer, seule l'entrée métier est verrouillée.
enum UserStatus {
  ACTIVE
  PENDING_VALIDATION
  BLOCKED
}

// ---------------------------------------------------------------------------
// Prestataires : un dossier unique pour tous les types d'activité
// (voir PROJECT_SUMMARY/PRESTATAIRES.md)
// ---------------------------------------------------------------------------

enum ProviderType {
  DRIVER // chauffeur indépendant (zem, zem électrique, voiture)
  AGENCY // agence / flotte
  ARTISAN
  COURIER // livreur — mappé sur le rôle DRIVER tant que le rôle COURIER n'existe pas
}

enum ProviderStatus {
  DRAFT // brouillon non soumis (reprise possible)
  SUBMITTED // déposé, en file d'attente admin
  UNDER_REVIEW // un admin a ouvert le dossier (verrou)
  NEED_INFO // pièce ou information manquante, renvoyé au prestataire
  APPROVED // validé : rôle accordé, espace métier ouvert
  REJECTED // refusé avec motif
  SUSPENDED // gelé (litige, document expiré, signalement)
}

enum DocumentKind {
  CNI
  SELFIE
  PERMIS
  CARTE_GRISE
  ASSURANCE
  VISITE_TECHNIQUE
  PHOTO_VEHICULE
  RCCM
  IFU
  STATUTS
  DIPLOME
  EXTRAIT_CASIER
}

enum DocumentStatus {
  PENDING
  VALID
  INVALID
}

enum ProviderEventType {
  CREATED
  UPDATED
  SUBMITTED
  DOCUMENT_ADDED
  DOCUMENT_VALIDATED
  DOCUMENT_REJECTED
  REVIEW_STARTED
  INFO_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
  AGENCY_ATTACHED
  AGENCY_DETACHED
}

enum RideStatus {
  PENDING
  MATCHED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Gammes de véhicules AZƆ̀ (spécification tarifaire) :
// GAZELLE (entrée de gamme), KOALA (intermédiaire climatisé), LEOPARD (haut de gamme).
// Les anciennes valeurs (ZEM, ZEM_ELECTRIC, CAR) ont été migrées :
// ZEM / ZEM_ELECTRIC -> GAZELLE, CAR -> KOALA.
// Types de véhicules AZƆ̀, en deux filières distinctes :
//   * ZEM_ESSENCE / ZEM_ELECTRIC → motos-taxis (filière Zem, même tarif) ;
//   * GAZELLE / KOALA / LEOPARD  → voitures (entrée de gamme, climatisée, premium).
enum VehicleType {
  ZEM_ESSENCE
  ZEM_ELECTRIC
  GAZELLE
  KOALA
  LEOPARD
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum Payer {
  SENDER
  RECIPIENT
}

// Niveaux d'agence (les niveaux ne concernent QUE les agences) :
// frais d'activation uniques, commission par course, frais par retrait, plafond de comptes.
enum AgencyPlan {
  PRO
  SILVER
  OR
  DIAMANT
}

model User {
  id        String     @id @default(uuid())
  phone     String     @unique
  fullName  String?
  role      Role       @default(CLIENT)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  // Dossier prestataire (null pour un simple client)
  provider ProviderProfile?

  wallet          Wallet?
  ridesAsClient   Ride[]             @relation("ClientRides")
  ridesAsDriver   Ride[]             @relation("DriverRides")
  notifications   Notification[]
  pushTokens      DevicePushToken[]
  deliveriesSent  Delivery[]         @relation("DeliveryClient")
  rentalBookings  RentalBooking[]
  marketOrders    MarketplaceOrder[]
  artisanRequests ArtisanRequest[]   @relation("ArtisanRequestClient")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Wallet {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  balance  Int    @default(0) // en FCFA
  cashback Int    @default(0)

  transactions Transaction[]
}

model Transaction {
  id        String          @id @default(uuid())
  walletId  String
  wallet    Wallet          @relation(fields: [walletId], references: [id])
  type      TransactionType
  amount    Int
  label     String
  meta      String?
  createdAt DateTime        @default(now())
}

model Agency {
  id             String     @id @default(uuid())
  name           String
  plan           AgencyPlan @default(PRO)
  // Valeurs par défaut = niveau PRO de la grille officielle (src/pricing/tarification.json).
  commissionRate Float      @default(0.03) // PRO : 3 % de commission par course
  maxAccounts    Int        @default(25) // PRO : 25 comptes maximum
  activationFee  Int        @default(100000) // PRO : frais d'activation uniques (FCFA)
  feePaidAt      DateTime? // null = frais pas encore encaissés
  createdAt      DateTime   @default(now())

  drivers   User[]
  providers ProviderProfile[]
}

model Ride {
  id          String      @id @default(uuid())
  clientId    String
  client      User        @relation("ClientRides", fields: [clientId], references: [id])
  driverId    String?
  driver      User?       @relation("DriverRides", fields: [driverId], references: [id])
  status      RideStatus  @default(PENDING)
  vehicleType VehicleType

  originLat Float
  originLng Float
  destLat   Float
  destLng   Float

  price           Int
  commission      Int
  rating          Int?
  pickupCode      String?
  driverArrivedAt DateTime?
  createdAt       DateTime  @default(now())
}

model Delivery {
  id            String     @id @default(uuid())
  clientId      String
  client        User       @relation("DeliveryClient", fields: [clientId], references: [id])
  courierId     String?
  packageType   String
  pickupAddress String
  dropAddress   String
  pickupCode    String
  deliveryCode  String
  payer         Payer      @default(SENDER)
  price         Int
  status        RideStatus @default(PENDING)
  createdAt     DateTime   @default(now())
}

model RentalBooking {
  id           String   @id @default(uuid())
  clientId     String
  client       User     @relation(fields: [clientId], references: [id])
  vehicleModel String
  formula      String
  pricePerDay  Int
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}

model MarketplaceOrder {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation(fields: [clientId], references: [id])
  market    String
  items     Json // [{ label, note, price }]
  total     Int
  status    String   @default("escrowed") // escrowed, delivered, refunded
  createdAt DateTime @default(now())
}

model ArtisanRequest {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation("ArtisanRequestClient", fields: [clientId], references: [id])
  category  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Dossier prestataire — créé à l'inscription (brouillon), soumis par le
// prestataire, instruit et tranché par un administrateur.
// Le rôle métier n'est accordé QU'À l'approbation.
// ---------------------------------------------------------------------------
model ProviderProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   ProviderType
  status ProviderStatus @default(DRAFT)

  // Identité déclarée (wizard prestataire)
  fullName        String?
  city            String?
  zones           String[]
  bio             String?
  experienceYears Int?

  // Spécifique au type d'activité
  vehicleType  VehicleType? // DRIVER / COURIER
  vehicleModel String?
  plateNumber  String?
  categoryId   String? // ARTISAN
  agencyName   String? // AGENCY : raison sociale
  plan         AgencyPlan? // AGENCY : formule choisie (tarif + commission)

  // Rattachement validé à une flotte
  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  // Instruction du dossier
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String? // admin ayant statué
  rejectReason     String?
  suspensionReason String?
  infoRequested    String? // ce que l'admin attend (statut NEED_INFO)

  // Vie du compte après approbation
  activatedAt   DateTime?
  rating        Float     @default(0)
  jobsCompleted Int       @default(0)
  kycScore      Int       @default(0) // 0-100 : pièces valides et non expirées

  documents ProviderDocument[]
  events    ProviderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([agencyId])
}

model ProviderDocument {
  id         String          @id @default(uuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  kind         DocumentKind
  // Renseigné par l'upload réel des fichiers (étape 3d) : pour l'instant le dossier
  // peut porter la déclaration d'une pièce sans le fichier.
  url          String?
  mimeType     String?
  sizeBytes    Int?
  status       DocumentStatus @default(PENDING)
  expiresAt    DateTime? // permis, assurance, visite technique, CNI
  reviewerNote String?
  uploadedAt   DateTime       @default(now())
  reviewedAt   DateTime?

  @@unique([providerId, kind])
  @@index([status])
}

// Journal du dossier : chaque action est tracée (qui, quand, pourquoi).
model ProviderEvent {
  id         String            @id @default(uuid())
  providerId String
  provider   ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  actorId    String? // null = le prestataire lui-même
  type       ProviderEventType
  comment    String?
  createdAt  DateTime          @default(now())

  @@index([providerId, createdAt])
}
