# Copie ce fichier en ".env" et remplis les valeurs
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/azo?schema=public"
JWT_SECRET="change-moi-par-une-longue-chaine-aleatoire"
# Génère chacune de ces clés séparément avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NPI_ENCRYPTION_KEY=""
NPI_HASH_KEY=""
PORT=3000

# Numéro du premier administrateur (créé par `npm run seed`).
# Seul ce script peut donner le rôle ADMIN : aucune route de l'API ne le permet.
ADMIN_PHONE="+22900000000"

# Passerelle SMS (Twilio ou fournisseur local) — à brancher dans auth.service.ts
SMS_API_KEY=""

# Paiement Mobile Money (FedaPay / CinetPay)
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
