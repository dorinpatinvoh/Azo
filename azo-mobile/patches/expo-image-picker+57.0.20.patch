+// URI MediaStore créées par le repli ci-dessus : seules celles-ci sont supprimées après usage (jamais une photo choisie par l'utilisateur).
+private val temporaryMediaStoreUris: MutableSet<String> = java.util.Collections.synchronizedSet(mutableSetOf())
+
+private fun File.toMediaStoreUri(context: Context): Uri? = runCatching {
+  val isVideo = extension.equals("mp4", ignoreCase = true)
+  val values = ContentValues().apply {
+    put(MediaStore.MediaColumns.DISPLAY_NAME, name)
+    put(
+      MediaStore.MediaColumns.MIME_TYPE,
+      if (isVideo) "video/mp4" else if (extension.equals("png", ignoreCase = true)) "image/png" else "image/jpeg"
+    )
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+      put(MediaStore.MediaColumns.RELATIVE_PATH, (if (isVideo) Environment.DIRECTORY_MOVIES else Environment.DIRECTORY_PICTURES) + "/AZO")
+    }
+  }
+  val collection = if (isVideo) MediaStore.Video.Media.EXTERNAL_CONTENT_URI else MediaStore.Images.Media.EXTERNAL_CONTENT_URI
+  context.contentResolver.insert(collection, values)?.also { temporaryMediaStoreUris.add(it.toString()) }
+}.getOrNull()
+
+/** Supprime l'entrée MediaStore temporaire (pièce d'identité…) pour qu'elle ne reste pas dans la galerie. */
+internal fun discardTemporaryMediaStoreUri(context: Context, uri: Uri) {
+  if (temporaryMediaStoreUris.remove(uri.toString())) {
+    runCatching { context.contentResolver.delete(uri, null, null) }
+  }
+}
