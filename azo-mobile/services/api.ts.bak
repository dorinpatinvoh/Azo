// Client HTTP de l'app AZƆ̀ : parle au backend NestJS.
//
// ⚠️ IMPORTANT : remplace l'adresse ci-dessous par l'IP de TON ordinateur sur le Wi-Fi
// (commande : hostname -I  -> prends la première, ex. 192.168.100.10).
// "localhost" ne marche PAS depuis un téléphone : pour lui, localhost = le téléphone lui-même.
//   - Téléphone réel (Expo Go)  : http://192.168.x.x:3000
//   - Émulateur Android         : http://10.0.2.2:3000
//   - Navigateur (expo web)     : http://localhost:3000
export const API_URL = "http://192.168.100.10:3000";

let authToken: string | null = null;
export const setToken = (t: string | null) => {
  authToken = t;
};

async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
  const res = await fetch(`${API_URL}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(authToken ? { Authorization: `Bearer ${authToken}` } : {}),
    },
  });

  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    // NestJS renvoie { message: "..." } ou { message: ["...", "..."] }
    const msg = Array.isArray(data.message) ? data.message.join("\n") : data.message;
    throw new Error(msg || `Erreur ${res.status}`);
  }
  return data as T;
}

export const api = {
  get: <T>(path: string) => request<T>(path),
  post: <T>(path: string, body?: unknown) =>
    request<T>(path, { method: "POST", body: body ? JSON.stringify(body) : undefined }),
};

// ---------------------------------------------------------------------------
// Un raccourci par module du backend. Les écrans n'écrivent jamais d'URL :
// ils appellent authApi.verifyOtp(...), walletApi.get(), etc.
// ---------------------------------------------------------------------------

export const authApi = {
  requestOtp: (phone: string) => api.post<{ message: string }>("/auth/request-otp", { phone }),
  verifyOtp: async (phone: string, code: string) => {
    const r = await api.post<{ token: string; user: { id: string; role: string } }>(
      "/auth/verify-otp",
      { phone, code }
    );
    setToken(r.token); // toutes les requêtes suivantes sont authentifiées
    return r;
  },
};

export const userApi = {
  me: () => api.get<{ id: string; phone: string; fullName: string | null; role: string }>("/users/me"),
};

export type VehicleType = "ZEM" | "ZEM_ELECTRIC" | "CAR";

export const ridesApi = {
  create: (body: {
    originLat: number;
    originLng: number;
    destLat: number;
    destLng: number;
    vehicleType: VehicleType;
  }) => api.post<{ id: string; price: number }>("/rides", body),
  rate: (rideId: string, stars: number) => api.post(`/rides/${rideId}/rate`, { stars }),
};

export type WalletTransaction = {
  id: string;
  type: "CREDIT" | "DEBIT";
  amount: number;
  label: string;
  meta: string | null;
  createdAt: string;
};

export const walletApi = {
  get: () => api.get<{ balance: number; cashback: number }>("/wallet"),
  transactions: () => api.get<WalletTransaction[]>("/wallet/transactions"),
  recharge: (amount: number, method: string) => api.post("/wallet/recharge", { amount, method }),
};

export const deliveryApi = {
  create: (body: {
    packageType: string;
    pickupAddress: string;
    dropAddress: string;
    payer: "SENDER" | "RECIPIENT";
    price: number;
  }) => api.post<{ id: string; pickupCode: string; deliveryCode: string }>("/deliveries", body),
};

export const rentalApi = {
  book: (body: { vehicleModel: string; formula: string; pricePerDay: number }) =>
    api.post("/rentals", body),
};

export const marketplaceApi = {
  order: (body: { market: string; items: { label: string; note?: string; price: number }[] }) =>
    api.post("/marketplace/orders", body),
};

export const artisansApi = {
  request: (category: string) => api.post("/artisans/requests", { category }),
};
