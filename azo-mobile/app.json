{
  "expo": {
    "name": "AZO",
    "slug": "azo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.azo.app"
    },
    "android": {
      "package": "bj.azo.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AZO a besoin de ta position pour te trouver un chauffeur."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AZO utilise tes photos pour joindre tes pieces justificatives a ton dossier prestataire.",
          "cameraPermission": "AZO utilise l'appareil photo pour ton selfie de verification et tes pieces justificatives."
        }
      ]
    ]
  }
}
